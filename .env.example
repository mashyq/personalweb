# ---------------------------------------------------------------------------
# Production origin. Used for canonical URLs, Open Graph, JSON-LD, robots.txt
# and sitemap.xml. No trailing slash. REQUIRED for a production build.
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Social preview image. Defaults to /og-image.svg (1200x630).
# X/Twitter does not reliably render SVG cards — export a PNG and point here.
# ---------------------------------------------------------------------------
VITE_OG_IMAGE=/og-image.png

# ---------------------------------------------------------------------------
# Search engine verification tokens (optional).
# Search Console -> Settings -> Ownership verification -> HTML tag
# Bing Webmaster Tools -> Settings -> Website Management -> Verification
# ---------------------------------------------------------------------------
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Contact form endpoint (optional).
# Any URL that accepts a JSON POST works — Formspree, Web3Forms, Basin, etc.
# Leave unset and the form falls back to opening the visitor's email client.
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=