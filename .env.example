# ---------------------------------------------------------------------------
# OPTIONAL. Leave unset if you deploy to Vercel.
#
# Vercel injects VERCEL_PROJECT_PRODUCTION_URL at build time, so the canonical
# URL, sitemap.xml, robots.txt, Open Graph tags and JSON-LD resolve themselves
# to your real <project>.vercel.app domain with no configuration at all.
#
# Set VITE_SITE_URL only when you need to override that, for example:
#   - you later attach a custom domain and want it as canonical
#   - you build locally and want the output to be deploy-ready
#
# Must be an absolute https origin with no trailing slash. Placeholder hosts
# and http:// are rejected at build time.
#
# Your production domain: https://frankmachariatech.vercel.app
# (Vercel may have assigned a hash suffix, e.g. -abc123. Confirm the exact
# value in Vercel -> Project -> Settings -> Domains and update it here.)
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://frankmachariatech.vercel.app

# ---------------------------------------------------------------------------
# OPTIONAL. Social preview image. Defaults to /og-image.svg (1200x630).
# Export a PNG and point here for the widest platform support.
# ---------------------------------------------------------------------------
VITE_OG_IMAGE=/og-image.png

# ---------------------------------------------------------------------------
# Search engine verification tokens.
# Search Console -> Settings -> Ownership verification -> HTML tag
# Bing Webmaster Tools -> Settings -> Website Management -> Verification
#
# The Google token is already committed as the default in src/lib/seo.js, so
# the meta tag ships to production with no configuration. Set it here only to
# override that value (e.g. a new property or a different environment).
#
# NOTE: verification tokens are PUBLIC by design. They must be readable in the
# page source for Google to find them. Never put a real API key, password or
# private token in a VITE_ var, because every VITE_ value is inlined into the
# public client bundle.
# ---------------------------------------------------------------------------
VITE_GOOGLE_SITE_VERIFICATION=L6akMy7RZn-kdHByjLPDaGKzkgh2_3O4zGmMl2tbv0k
VITE_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# OPTIONAL. Contact form endpoint.
# Any URL that accepts a JSON POST works: Formspree, Web3Forms, Basin, etc.
# Leave unset and the form falls back to opening the visitor's email client.
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=
